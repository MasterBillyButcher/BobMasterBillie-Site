// BobMasterBillie Command Center — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 🎬 Movie planner — planned / watching / watched with calendar dates
model Movie {
  id          String    @id @default(cuid())
  title       String
  status      String    @default("planned") // planned | watching | watched
  notes       String?
  plannedDate DateTime? // scheduled watch date (calendar)
  watchedDate DateTime? // date it was actually watched
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 🗳️ Twitch predictions — copy-paste ready text for channel-point predictions
model Prediction {
  id           String    @id @default(cuid())
  title        String // the prediction question
  options      String    @default("[\"Yes\",\"No\"]") // JSON array of option labels
  announceText String? // e.g. /announcepurple 🎯 ... — announcement to paste in chat
  duration     String    @default("5 minutes") // suggested prediction window
  category     String    @default("custom") // hype | treasure | satta | babu | custom
  status       String    @default("ready") // ready | used
  outcome      String? // e.g. "Yes — we completed it!"
  usedAt       DateTime?
  pinned       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 🚫 Veto Power board — veto rights only (VIP is tracked separately)
model Veto {
  id         String   @id @default(cuid())
  username   String
  vetoRights Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ⭐ VIP Board — VIP members (separate from veto rights)
model VipMember {
  id        String    @id @default(cuid())
  username  String
  status    String    @default("active") // active | probation | revoked
  grantedAt DateTime? // when VIP was granted
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 📅 VIP events — monthly VIP grant/revoke/return history
model VipEvent {
  id        String   @id @default(cuid())
  username  String
  eventType String // granted | revoked | probation | returned
  month     String // "2026-10" — event month for grouping
  note      String?
  createdAt DateTime @default(now())
}

// ⚖️ Backlog count ledger — keeps watched vs earned movies balanced
// +1 = bits goal completed (a movie earned) · −1 = movie watched
model BacklogEvent {
  id         String   @id @default(cuid())
  type       String // bits_goal | watched
  delta      Int // +1 | -1
  note       String?
  movieId    String? // linked movie (auto watch events)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// 📜 Activity Log — every update, every log
model ActivityLog {
  id        String   @id @default(cuid())
  type      String   @default("update") // movie | prediction | veto | vip | announcement | stream | custom
  action    String   @default("note") // created | updated | deleted | note | scheduled
  title     String
  details   String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 📣 Channel announcements (state of the stream, session rules, etc.)
model Announcement {
  id        String   @id @default(cuid())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
